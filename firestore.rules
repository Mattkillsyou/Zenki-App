rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Zenki Dojo — Firestore Security Rules
//
// Principle: default deny. Only signed-in users can read most data,
// and users can only write to their own documents.
// Admin-only write paths are gated by `allow write: if false` here
// and will be opened up via Cloud Functions when admin UI is wired.
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    // The other member of a deterministic 2-party conversation (participants = [a, b]).
    function otherParty(parts, me) { return parts[0] == me ? parts[1] : parts[0]; }

    // Admin check — either a custom claim (token.admin == true) or a seeded
    // doc at /admins/{uid}. The doc path is the easy bootstrap; wire custom
    // claims via a Cloud Function later. See ADMIN_SETUP.md.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Trainer check — a READ-ONLY coaching role, deliberately weaker than admin.
    // Mirrors isAdmin()'s shape: a custom claim (token.trainer == true) or a
    // seeded doc at /trainers/{uid}. A trainer may READ member training data
    // (members, attendance, appointments, orders) so the web admin's trainer
    // view can show who is showing up and how often — but grants NO write, and
    // NOT the admin surface (ban, hard-delete, broadcast, moderation, editing).
    // `isEmployee` on a member doc is NOT this: it's only a write-elevation
    // guard and confers zero read power. Being an admin does not imply trainer;
    // rules that both roles may read say `isAdmin() || isTrainer()`.
    //
    // COST NOTE: isTrainer() is always appended LAST in an OR chain so the
    // common paths (a member reading their own doc) short-circuit before it and
    // never pay for the extra exists() lookup.
    function isTrainer() {
      return isSignedIn() && (
        request.auth.token.trainer == true ||
        exists(/databases/$(database)/documents/trainers/$(request.auth.uid))
      );
    }

    // True if the signed-in user has an approved follower edge to `authorUid`
    // (i.e. /followers/{authorUid}/followers/{me} exists). Used to let approved
    // followers read a private author's posts on that author's profile.
    function isApprovedFollowerOf(authorUid) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/followers/$(authorUid)/followers/$(request.auth.uid));
    }

    // True if the target account is NOT private. Used to stop a user from
    // self-adding as a follower of a PRIVATE account (which would otherwise make
    // isApprovedFollowerOf() true and expose that account's private posts).
    function isPublicAccount(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('isPrivate', false) != true;
    }

    // True if EITHER user has blocked the other. Used to stop a blocked user from
    // delivering NEW direct messages (block-evasion / harassment) at the rules
    // layer — the client only hides the BLOCKER's own composer, which does nothing
    // to stop the blocked party's app from sending. Purely additive: it only ever
    // DENIES a send, never widens any read/write.
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a)/blocked/$(b))
          || exists(/databases/$(database)/documents/blocks/$(b)/blocked/$(a));
    }

    // The other participant of a conversation (by id), resolved from the stored
    // participants array. Used by the DM block-on-read gate. The get() is cached
    // with the membership get() on the same path within one rule evaluation.
    function otherInConversation(convId, me) {
      return otherParty(
        get(/databases/$(database)/documents/conversations/$(convId)).data.participants, me);
    }

    // A non-admin member write must not grant itself privileged fields. Admins
    // provision employees/admins through the isAdmin() branch instead.
    // CREATE guard: a self-created member doc must not grant itself privileged
    // fields (no isAdmin/isEmployee true, no hourlyRate). `resource` is null on
    // create, so this only inspects the incoming doc.
    function memberWriteNotElevating() {
      return !('isAdmin' in request.resource.data && request.resource.data.isAdmin == true)
          && !('isEmployee' in request.resource.data && request.resource.data.isEmployee == true)
          && !('hourlyRate' in request.resource.data);
    }

    // UPDATE guard: a self-update must not CHANGE privileged fields from their
    // existing values. (request.resource.data is the post-merge doc, so checking
    // `not present` like the create guard wrongly blocks every self-edit by a
    // member whose stored doc already carries isEmployee/hourlyRate — e.g. an
    // employee changing their avatar. Compare to resource.data instead.)
    function memberUpdateNotElevating() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
          && request.resource.data.get('isEmployee', false) == resource.data.get('isEmployee', false)
          && request.resource.data.get('hourlyRate', 0) == resource.data.get('hourlyRate', 0);
    }

    // Member profiles keyed by Firebase Auth uid.
    // Anyone signed in can read profiles (for community features).
    // Only the owner can create/update/delete their own profile.
    //
    // /users is the PUBLIC cross-user projection (displayName / avatar / bio /
    // isPrivate / counters + the memberId pointer). It must never carry the
    // full Member record: older OAuth builds stored it here as a `member:`
    // field (real email + name, readable by any signed-in user — finding
    // 1-P1.2), silently defeating the /members PII lockdown below. The write
    // guard blocks the field from ever coming back; backfillUsersPii strips
    // it from existing docs.
    // ⚠️ DEPLOY SEQUENCING: app builds ≤ 2.0.2 still write `member:` on a
    // FIRST-TIME OAuth sign-in — those creates are denied for as long as such
    // installs exist (not just a release window), so deploy this guard only
    // with/after the client release that stops doing so, and expect stragglers
    // on old builds to need an app update before their first OAuth sign-in
    // succeeds. Run backfillUsersPii right after deploying these rules to
    // strip the legacy blob from existing docs.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
                    && !('member' in request.resource.data);
      // UPDATE: request.resource.data is the POST-write doc, so a blanket
      // !('member' in ...) would deny EVERY owner update to a legacy doc that
      // still carries the blob (profile edits, privacy toggle, follow
      // counters, acceptedTermsAt) until backfillUsersPii has run. Tolerate a
      // pre-existing `member` that the write leaves byte-identical (or
      // deletes); still block introducing or modifying it.
      allow update: if isOwner(uid)
                    && (!('member' in request.resource.data)
                        || ('member' in resource.data
                            && request.resource.data.member == resource.data.member));
      allow delete: if isOwner(uid);
    }

    // Members collection — keyed by the app's local member id (not the
    // Firebase Auth uid). Anyone signed in can read for community / admin
    // browsing.
    //
    // Create: a signed-in user can create their OWN member doc as long as
    // the doc's firebaseUid matches their auth uid. This unblocks the
    // self-signup flow (Onboarding → createAccount) so new users actually
    // appear in the admin panel. Without it, only the seed members written
    // via admin-side backfill ever show up.
    //
    // Update / delete: admins always; otherwise the member can update their
    // own doc (firebaseUid match) for self-edits like avatar / bio.
    match /members/{memberId} {
      // Read locked down (was: any signed-in user — a mass PII + push-token
      // leak). Admins read everything; a member reads only their OWN doc
      // (matched by firebaseUid, or a not-yet-claimed doc with their email).
      // Cross-user public display fields are served from /users instead.
      //
      // The email-fallback branch deliberately does NOT require
      // email_verified: the app never calls sendEmailVerification, so every
      // password account is permanently unverified. Requiring it would lock
      // seed/reviewer members (whose docs have no firebaseUid stamp yet) out
      // of their OWN doc → broke profile-photo upload + self-claim. The email
      // match already scopes the fallback to the rightful owner. Do NOT re-add
      // email_verified here unless the app actually sends verification emails.
      // Trainers read the roster (name/belt/stripes/contact) for the web admin's
      // trainer view — appended LAST so a member reading their own doc
      // short-circuits before the extra exists() lookup.
      allow read: if isAdmin()
                  || (isSignedIn()
                      && (
                        resource.data.firebaseUid == request.auth.uid
                        || (!('firebaseUid' in resource.data)
                            && resource.data.email == request.auth.token.email)
                      ))
                  || isTrainer();
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.firebaseUid == request.auth.uid
                        && memberWriteNotElevating());
      // Update has two non-admin paths:
      //   (a) NORMAL — existing doc already stamped with this user's
      //       firebaseUid, and the new doc preserves that stamp.
      //   (b) FIRST-TIME CLAIM — existing doc has no firebaseUid yet AND
      //       its email matches the auth user's email (not verification-gated;
      //       see read-branch note above); the new doc must stamp the user's
      //       firebaseUid. Without this path
      //       any /members doc that landed without a firebaseUid (admin
      //       backfilled seed members, or an earlier signup that wrote
      //       /members but not the stamp) is permanently un-updatable
      //       by its rightful owner — which broke profile-photo uploads
      //       and silenced /members backfills on subsequent sign-ins.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.firebaseUid == request.auth.uid
                        && memberUpdateNotElevating()
                        && (
                          resource.data.firebaseUid == request.auth.uid
                          || (!('firebaseUid' in resource.data)
                              && resource.data.email == request.auth.token.email)
                        ));
      allow delete: if isAdmin();
    }

    // Posts — any signed-in user can read.
    // The poster owns the post and can edit/delete their own; admins can
    // delete any post for moderation actions (Reports → Remove & Block).
    match /posts/{postId} {
      // Privacy: a private author's posts are readable only by the author, an
      // admin, or an approved follower. Public posts (authorIsPrivate absent or
      // false) are readable by any signed-in user. Feeds add
      // where('authorIsPrivate','==',false) so multi-author list queries are
      // satisfied by the public branch (no per-doc exists()); the single-author
      // profile query (getUserPosts) resolves the exists() branch against one
      // author. See SOCIAL_CONTRACT.md §10.
      allow read: if isSignedIn() && (
                        resource.data.userId == request.auth.uid
                        || isAdmin()
                        || resource.data.get('authorIsPrivate', false) != true
                        || isApprovedFollowerOf(resource.data.userId)
                      );
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      // Owner can update their own post freely. Any signed-in user may touch
      // ONLY the `likes` counter, and ONLY by exactly ±1 — so the like/unlike
      // flow needs no Cloud Function but a malicious client can't set an
      // arbitrary like total (was: any value).
      allow update: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                            && (request.resource.data.likes == resource.data.likes + 1
                                || request.resource.data.likes == resource.data.likes - 1)));
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());

      // Likes — each user owns one like-doc per post, keyed by their uid.
      // Anyone signed in can read (so feed renders the heart state); only
      // the owner can write theirs.
      match /likes/{likerUid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(likerUid);
      }

      // Comments — anyone signed in reads; only the comment author writes.
      // Admins may also delete a comment (moderation: Reports → Remove).
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
                      && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn()
                      && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Direct-message conversations — only participants read/write. The client
    // (firebaseMessages.ts) uses `/conversations`, NOT the old `/threads`
    // collection, so the rule must match — otherwise every DM op fell to
    // default-deny and messaging was silently broken in prod.
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participants;
      // Deterministic 2-party conversation; creator must be a participant.
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      // Participants may update only the summary/unread/profile fields, and may
      // NOT rewrite the participants array (prevents inbox spoofing / injecting
      // yourself into someone else's thread).
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'lastSenderId', 'lastMessageAt', 'unreadFor', 'participantProfiles'])
                    // A writer may only mutate their OWN participantProfiles entry —
                    // hasOnly() above checks only top-level keys, so without this a
                    // participant could overwrite the other party's denormalized
                    // name/avatar. (Escape hatch for legacy convos introducing the
                    // field; the legit per-message write only touches the sender's
                    // own entry, so it still passes.)
                    && (
                      !('participantProfiles' in resource.data)
                      || request.resource.data.participantProfiles
                           .diff(resource.data.participantProfiles).affectedKeys()
                           .hasOnly([request.auth.uid])
                    )
                    // A writer may not LOWER the OTHER party's unread count (that
                    // would hide their unread messages). Their own they may reset
                    // on read; the other's they may only raise (send). Blocks the
                    // unread-badge griefing the audit flagged, while passing the
                    // legit send (increment other) + read (reset own) writes.
                    && (
                      !('unreadFor' in resource.data)
                      || !(otherParty(resource.data.participants, request.auth.uid) in resource.data.unreadFor)
                      || (otherParty(resource.data.participants, request.auth.uid) in request.resource.data.unreadFor
                          && request.resource.data.unreadFor[otherParty(resource.data.participants, request.auth.uid)]
                             >= resource.data.unreadFor[otherParty(resource.data.participants, request.auth.uid)]
                          // Also CAP inflation: a single write may raise the other party's
                          // unread by at most 1 (the legit send increments by exactly 1), so
                          // a participant can't spike the other's badge to an arbitrary number.
                          && request.resource.data.unreadFor[otherParty(resource.data.participants, request.auth.uid)]
                             <= resource.data.unreadFor[otherParty(resource.data.participants, request.auth.uid)] + 1)
                    );

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                    // D3: the BLOCKED party can't read the thread when the OTHER
                    // participant has blocked them. Asymmetric — the blocker keeps
                    // read access so their own inbox/thread isn't broken; new DMs are
                    // already denied by the create rule's blockedBetween guard.
                    && !exists(/databases/$(database)/documents/blocks/$(otherInConversation(conversationId, request.auth.uid))/blocked/$(request.auth.uid));
        allow create: if isSignedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.senderId == request.auth.uid
                      // Block-evasion guard: deny the send if either participant has
                      // blocked the other. Without this, a blocked user's client still
                      // shows a working composer and the write succeeds (the client gate
                      // only hides the BLOCKER's composer). See SOCIAL_AUDIT.md.
                      && !blockedBetween(
                           request.auth.uid,
                           otherParty(
                             get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants,
                             request.auth.uid));
        // No client update/delete — redaction is admin-only via the Admin SDK.
      }
    }

    // Follow edges — public-ish graph.
    // Legacy single-collection shape (kept for older clients).
    // `resource` is null on create — split create/delete so the right side
    // of the comparison is non-null in each case.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.followerId == request.auth.uid;
    }

    // Active subcollection shape used by `firebaseFollow.ts`:
    //   /following/{followerUid}/follows/{followedUid}
    // The follower owns their own follows list. Anyone signed in can read
    // any user's follows list (used by getFeed to discover who to query and
    // by profile screens to show follow counts).
    match /following/{followerUid}/follows/{followedUid} {
      allow read: if isSignedIn();
      // The follower may create their own edge ONLY to a PUBLIC account (a
      // private account is followable only via an approved request — see the
      // followedUid branch). Without the isPublicAccount() gate a user could
      // self-add as a follower of a private account and thereby read its private
      // posts. The followed user may create the edge when approving a pending
      // request (acceptFollowRequest); rules see pre-batch state, so the request
      // still exists while accept's batch also deletes it.
      allow create: if (isOwner(followerUid) && isPublicAccount(followedUid))
                    || (isOwner(followedUid)
                        && exists(/databases/$(database)/documents/followRequests/$(followedUid)/requests/$(followerUid)));
      allow update, delete: if isOwner(followerUid) || isOwner(followedUid);
    }

    // Follower mirror edge: /followers/{followedUid}/followers/{followerUid}.
    // Written by followUser (the follower) and by acceptFollowRequest (the
    // followed user approving). Anyone signed in can read (follower counts /
    // approved-follower checks). Was MISSING → default-denied, which broke
    // follower counts and the private-account approval flow.
    match /followers/{followedUid}/followers/{followerUid} {
      allow read: if isSignedIn();
      // Follower may self-create this edge ONLY for a PUBLIC target (private
      // accounts require an approved request — the followedUid branch). This is
      // the key gate that stops a non-follower from reading a private account's
      // posts by fabricating their own approved-follower edge.
      allow create: if (isOwner(followerUid) && isPublicAccount(followedUid))
                    || (isOwner(followedUid)
                        && exists(/databases/$(database)/documents/followRequests/$(followedUid)/requests/$(followerUid)));
      allow delete: if isOwner(followerUid) || isOwner(followedUid);
    }

    // Pending follow requests to a private account:
    //   /followRequests/{targetUid}/requests/{requesterUid}
    // The requester creates/cancels their own request; the target reads their
    // pending queue and deletes on accept/decline. Was MISSING → the private
    // follow flow was silently broken.
    match /followRequests/{targetUid}/requests/{requesterUid} {
      // The requester may read THEIR OWN outbound request (audit 2.0.5 F1:
      // target-only read meant "Requested" could never survive a reload —
      // the requester's own status check was permission-denied). Leaks
      // nothing: they wrote the doc.
      allow read: if isOwner(targetUid) || isOwner(requesterUid);
      // A blocked user may not file (or re-file) a follow request against
      // either side of the block — same guard as the DM create rule.
      allow create: if isOwner(requesterUid)
                    && !blockedBetween(requesterUid, targetUid);
      allow delete: if isOwner(requesterUid) || isOwner(targetUid);
    }

    // Mutes — soft-hide (feed/comments) without blocking. Owner-only; the muted
    // user is never told and can still interact. /mutes/{uid}/muted/{mutedUid}.
    match /mutes/{uid}/muted/{mutedUid} {
      allow read, write: if isOwner(uid);
    }

    // Push tokens — relocated off the (now locked-down) /members doc so a
    // signed-in user can no longer scrape every member's Expo push token.
    // Owner writes their own; owner or admin reads (admin broadcast lists them).
    match /pushTokens/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Attendance — owner-or-admin read only (each doc carries member presence
    // PII: memberName, date, checkInTime). A signed-in member can read only
    // their OWN visits; admins (AttendanceContext only subscribes for admins)
    // read all. A member can only check THEMSELVES in, and the create is
    // field-validated so a forged row can't inject arbitrary name/date/time.
    // The doc carries `firebaseUid` (stamped at write) because the app's
    // internal `memberId` is not the auth uid. No updates or deletes (audit).
    match /attendance/{docId} {
      // Trainers read all check-ins — this is the backbone of the trainer view
      // (streaks, last-seen, 30-day volume are all derived from these rows).
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.firebaseUid == request.auth.uid)
                  || isTrainer();
      allow create: if isSignedIn()
                    && request.resource.data.firebaseUid == request.auth.uid
                    && request.resource.data.memberName is string
                    && request.resource.data.memberName.size() <= 80
                    && request.resource.data.date is string
                    && request.resource.data.checkInTime is string;
      allow update, delete: if false;
    }

    // Product catalog — readable by any signed-in member; writes restricted
    // to admins so AdminProductsScreen can manage the catalog directly.
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Custom (admin-added) product catalog. ProductContext writes here AND
    // subscribes here — without an explicit rule the collection fell to
    // the default-deny clause, every admin write was rejected, every read
    // came back empty, and the Store tab showed the local optimistic add
    // for a beat before being clobbered by the empty snapshot. Same access
    // model as /products.
    match /customProducts/{productId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Scheduling config (session names / prices / showPricing) is
    // non-sensitive display data that Book Private needs BEFORE sign-in —
    // guests (App Review 5.1.1(v)) have no Firebase session, so the
    // signed-in gate below permission-denied their listener and they were
    // stuck on hardcoded defaults forever. Public read, scoped to this ONE
    // doc; every other /config doc keeps the signed-in gate.
    match /config/scheduling {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App-wide config (e.g. scheduling pricing). Readable by any signed-in
    // user; only admins may write.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Waivers — submit-only. No one reads from client (admin reads server-side).
    match /waivers/{waiverId} {
      allow read: if false;
      // Was `memberId == auth.uid`, but the waiver carries the app's INTERNAL
      // member id (not the auth uid), so every signed waiver was rejected and
      // none ever persisted. waiverSync now stamps `firebaseUid`.
      allow create: if isSignedIn()
                    && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Support messages — write-only from client.
    match /supportMessages/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // AI rate-limit state — Cloud Functions only (Admin SDK bypasses rules).
    match /aiRateLimits/{uid}/endpoints/{endpoint} {
      allow read, write: if false;
    }

    // Blocks — each user owns a /blocks/{uid}/blocked subcollection of
    // UIDs they've blocked. The owner reads/writes their own list, and
    // admins can write on the owner's behalf when actioning a report
    // (so a "Remove & Block" decision protects the reporter automatically).
    match /blocks/{uid}/blocked/{blockedUid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Mirror of the /blocks graph, maintained by the blockMirror Cloud Function
    // (Admin SDK). /blockedBy/{uid}/by/{blockerUid} lets a user discover who has
    // blocked THEM, so the client can hide the blocker bidirectionally (feed /
    // search / profile / inbox). Owner-read only; never client-written (so a user
    // can't forge "X blocked me").
    match /blockedBy/{uid}/by/{blockerUid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Reports — users can file a report (write-only from client).
    // Admins can read the queue and update the status (dismiss / actioned)
    // directly from AdminReportsScreen; deletes still blocked so we keep
    // the audit trail.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.targetType in ['post', 'message', 'user', 'comment']
                    && request.resource.data.reason is string
                    && request.resource.data.targetId is string
                    && request.resource.data.targetUserId is string
                    // Optional parentId carries the postId for comment reports
                    // so an admin can delete posts/{parentId}/comments/{targetId}.
                    && (!('parentId' in request.resource.data)
                        || request.resource.data.parentId is string);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Admins collection — the /admins/{uid} doc opens up isAdmin() for that
    // user. Only other admins (or the console) can write.
    match /admins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // Training — workout logs + personal records, keyed by Firebase Auth uid in
    // the PATH (NOT the app's internal memberId). Previously AsyncStorage-only
    // and lost on reinstall; moved online so a member's training history
    // survives an app delete or a new phone.
    //
    // Owner-only, matching the /nutrition stance — a member's training log is
    // theirs. Trainers/admins do NOT read it here; if that's wanted later it
    // should be a deliberate, disclosed decision (and the trainer view reads
    // /attendance, which is a dojo record rather than a personal log).
    //
    // The field bounds below are a MATCHED PAIR with the clamps in
    // src/services/trainingSync.ts (sanitizeLog/sanitizePR). Change one and you
    // MUST change the other, or over-length rows write locally, get rejected
    // here, and silently never sync — the exact data-loss this migration exists
    // to end.
    // ─────────────────────────────────────────────────────────────
    match /training/{uid} {
      allow read, write: if isOwner(uid);

      match /logs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.date is string
                              && request.resource.data.title is string
                              && request.resource.data.title.size() <= 60
                              && request.resource.data.result is string
                              && request.resource.data.result.size() <= 60
                              && request.resource.data.notes is string
                              && request.resource.data.notes.size() <= 200
                              && request.resource.data.format in ['AMRAP', 'EMOM', 'FOR_TIME', 'TABATA', 'CHIPPER', 'STRENGTH', 'OTHER']
                              && request.resource.data.rxOrScaled in ['Rx', 'Scaled']
                              && request.resource.data.memberId is string
                              && (!('durationMinutes' in request.resource.data)
                                  || request.resource.data.durationMinutes is number);
      }

      match /personalRecords/{prId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.value is number
                              && request.resource.data.value > 0
                              && request.resource.data.exerciseKey is string
                              && request.resource.data.date is string
                              && request.resource.data.memberId is string
                              && (!('reps' in request.resource.data)
                                  || (request.resource.data.reps is number && request.resource.data.reps > 0))
                              && (!('notes' in request.resource.data)
                                  || (request.resource.data.notes is string && request.resource.data.notes.size() <= 200));
      }
    }

    // Trainers collection — the /trainers/{uid} doc opens up isTrainer() for
    // that user (read-only coaching access; see isTrainer() above). Only admins
    // grant/revoke it. isOwner(uid) on read so the web admin can resolve its own
    // role at sign-in; a trainer must NOT be able to enumerate other trainers or
    // self-grant, hence no isTrainer() branch here and admin-only writes.
    match /trainers/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // Class schedule — one doc per day key (`Mon`, `Tue`, …) holding the
    // full classes array. PUBLIC read: guests (App Review 5.1.1(v)) have no
    // Firebase session, so the old signed-in gate left them stuck on the stale
    // hardcoded seed schedule forever — same rationale (and precedent) as
    // /config/scheduling above. Only admins write.
    match /schedule/{dayKey} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Announcements — admin-only writes; all signed-in members read.
    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Appointments — admins manage everything; members can request their
    // own. The doc carries `firebaseUid` (stamped at write time from
    // `auth.currentUser.uid`) because the app's `memberId` is an internal
    // id ('1','2',…), not the Firebase Auth uid.
    match /appointments/{apptId} {
      // Read scoped to owner + admins (F25). `firebaseUid` is now the booking
      // member's uid — PRESERVED through admin edits (appointmentSync) and
      // backfilled for legacy docs (backfillAppointmentOwners) — so this no
      // longer hides a member's own sessions. Clients scope the listener to
      // match (admins stream all; members stream where firebaseUid==uid).
      // Trainers read (not write) private-session bookings for the trainer view.
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.firebaseUid == request.auth.uid)
                  || isTrainer();
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.resource.data.firebaseUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Employee task templates — admins manage default + assigned tasks;
    // members can create/edit/delete their own personal tasks (source must
    // be 'personal' and the doc's `firebaseUid` must match their auth uid).
    match /employeeTasks/{taskId} {
      // Personal tasks carry the owner's private to-do text — readable only
      // by the owner or an admin (was: any signed-in user, which let every
      // member's device download all staff personal to-dos). Shared
      // default/assigned tasks stay readable by any signed-in user. Rules
      // are NOT filters: the client's non-admin listeners are split so each
      // query is provably inside one branch (employeeTaskSync.subscribeToTasks).
      // Legacy personal docs need firebaseUid stamped first — run
      // backfillEmployeeTaskOwners with this deploy or they vanish from
      // their owners' lists.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.source in ['default', 'assigned'])
        || (isSignedIn()
            && resource.data.source == 'personal'
            && resource.data.firebaseUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.source == 'personal'
            && request.resource.data.firebaseUid == request.auth.uid);
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.source == 'personal'
            && resource.data.firebaseUid == request.auth.uid
            && request.resource.data.source == 'personal'
            && request.resource.data.firebaseUid == request.auth.uid);
      allow delete: if isAdmin()
        || (isSignedIn()
            && resource.data.source == 'personal'
            && resource.data.firebaseUid == request.auth.uid);
    }

    // Per-day task completion records — each member owns their own.
    // Doc id is `${taskId}_${memberId}_${date}`; the doc carries
    // `firebaseUid` so rules can verify against the auth uid.
    // No updates (audit trail).
    match /taskCompletions/{compId} {
      // Owner-or-admin: each completion is a per-member "who did what when"
      // record. A member reads only their own (EmployeeTaskContext scopes the
      // listener to where firebaseUid == uid for non-admins); admins read all.
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.firebaseUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.firebaseUid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.firebaseUid == request.auth.uid;
      allow update: if false;
    }

    // Store orders — a member creates their own order at checkout (doc carries
    // firebaseUid); the owner and admins can read it. No client update/delete —
    // fulfillment-status changes are admin-only (audit trail).
    match /orders/{orderId} {
      // Trainers read (not write) a member's dojo purchases. NOTE: /payments —
      // the Stripe ledger — stays admin-only; `orders` already shows what was
      // bought without exposing payment infrastructure.
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.firebaseUid == request.auth.uid)
                  || isTrainer();
      allow create: if isSignedIn()
                    && request.resource.data.firebaseUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Invite codes — validated server-side by the validateInviteCode Cloud
    // Function (Admin SDK, bypasses rules). Admins manage codes from the app;
    // clients never read this collection directly (no pre-auth read needed).
    match /inviteCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    // Stripe payment records — written ONLY by the stripeWebhook Cloud Function
    // (Admin SDK, bypasses rules) as the server-authoritative record that a
    // charge succeeded. Admins read for reconciliation; clients never touch it.
    match /payments/{paymentIntentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // Nutrition — weight log, macro/food log, macro goals, BMR/TDEE
    // profile. ALL keyed by Firebase Auth uid in the PATH (NOT the
    // app's internal memberId), so the owner IS the path segment and
    // the rule is a plain isOwner() check — no per-doc firebaseUid
    // stamping or field-equality dance (unlike attendance/appointments,
    // which are flat collections). The server (Admin SDK, senpaiChat
    // tools) BYPASSES these rules and writes the same /nutrition/{uid}/…
    // paths using the uid from the verified ID token, so client and
    // server share one source of truth. See NUTRITION_FIRESTORE_SCHEMA.md.
    //
    // Health data is private: owner-only READ and WRITE. No cross-user
    // read — not even admins (medical-adjacent PII; moderation never
    // needs it). `memberId` inside the docs is denormalized only: the
    // client re-stamps it on read, so it is OPTIONAL here (a future
    // server tool knows only the uid) and is intentionally NOT the
    // security boundary.
    // ─────────────────────────────────────────────────────────────
    match /nutrition/{uid} {
      allow read, write: if isOwner(uid);

      // Weight log — one doc per weigh-in. weight is in `unit` (lb|kg).
      match /weightEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.weight is number
          && request.resource.data.weight > 0
          && request.resource.data.weight < 2000
          && request.resource.data.unit in ['lb', 'kg']
          && request.resource.data.date is string
          && (!('memberId' in request.resource.data)
              || request.resource.data.memberId is string);
      }

      // Macro/food log — one doc per logged item. calories kcal, macros g.
      // Upper bounds are deliberately generous (block 1000000-style typos that
      // would poison the adaptive TDEE sum, not constrain real meals). memberId
      // is optional (denormalized; client re-stamps on read).
      match /macroEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.calories is number && request.resource.data.calories >= 0 && request.resource.data.calories < 20000
          && request.resource.data.protein  is number && request.resource.data.protein  >= 0 && request.resource.data.protein  < 5000
          && request.resource.data.carbs    is number && request.resource.data.carbs    >= 0 && request.resource.data.carbs    < 5000
          && request.resource.data.fat      is number && request.resource.data.fat      >= 0 && request.resource.data.fat      < 5000
          && request.resource.data.date is string
          && (!('memberId' in request.resource.data)
              || request.resource.data.memberId is string)
          && (!('mealType' in request.resource.data)
              || request.resource.data.mealType in ['breakfast', 'lunch', 'dinner', 'snacks']);
      }

      // Macro goals — singleton locked to the doc id `current`.
      match /macroGoals/current {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.calories is number && request.resource.data.calories >= 0 && request.resource.data.calories < 20000
          && request.resource.data.protein  is number && request.resource.data.protein  >= 0 && request.resource.data.protein  < 5000
          && request.resource.data.carbs    is number && request.resource.data.carbs    >= 0 && request.resource.data.carbs    < 5000
          && request.resource.data.fat      is number && request.resource.data.fat      >= 0 && request.resource.data.fat      < 5000;
      }

      // BMR/TDEE profile — singleton locked to the doc id `current`.
      match /nutritionProfile/current {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.sex in ['male', 'female']
          && request.resource.data.ageYears is number
          && request.resource.data.heightCm is number
          && request.resource.data.activity in ['sedentary', 'light', 'moderate', 'active', 'very_active']
          && request.resource.data.goal in ['cut', 'maintain', 'bulk'];
      }
    }

    // Default deny — anything not listed above is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
